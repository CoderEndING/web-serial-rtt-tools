    },
    "cmsis-dap-generic": {
      "cfgs": ["interface/cmsis-dap.cfg"],
      "pre": ["cmsis-dap backend usb_bulk"],
      "speed": 1000,
      "note": "只加载探针，目标自己用 -c 指定（例如 -c \"target create ...\"）"
    }
  }
