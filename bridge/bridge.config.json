{
  "_说明": "桥的目标配置。cfgs 按顺序加载；pre 里的命令插在第一个 cfg 之后、其余 cfg 之前执行。",
  "targets": {
    "stm32f103": {
      "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f1x.cfg"],
      "pre": ["cmsis-dap backend usb_bulk"],
      "speed": 10000,
      "note": "CMSIS-DAP 探针 + STM32F103（SWD，10MHz；实测 OpenOCD 下 10MHz 吞吐最高）"
    },
    "stm32f0":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f0x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32F0（SWD 4MHz）" },
    "stm32f2":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f2x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32F2（SWD 4MHz）" },
    "stm32f3":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f3x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32F3（SWD 4MHz）" },
    "stm32f4":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f4x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32F4（SWD 4MHz）" },
    "stm32f7":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32f7x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32F7（SWD 4MHz）" },
    "stm32g0":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32g0x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32G0（SWD 4MHz）" },
    "stm32g4":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32g4x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32G4（SWD 4MHz）" },
    "stm32h7":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32h7x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32H7（SWD 4MHz）" },
    "stm32h5":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32h5x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32H5（SWD 4MHz）" },
    "stm32l0":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32l0.cfg"],  "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32L0（SWD 4MHz）" },
    "stm32l1":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32l1.cfg"],  "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32L1（SWD 4MHz）" },
    "stm32l4":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32l4x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32L4/L4+（SWD 4MHz）" },
    "stm32l5":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32l5x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32L5（SWD 4MHz）" },
    "stm32u5":  { "cfgs": ["interface/cmsis-dap.cfg", "target/stm32u5x.cfg"], "pre": ["cmsis-dap backend usb_bulk"], "speed": 4000, "note": "CMSIS-DAP + STM32U5（SWD 4MHz）" },
